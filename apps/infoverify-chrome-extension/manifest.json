{
  "manifest_version": 3,
  "name": "InfoVerify",
  "version": "0.1.0",
  "description": "Verify selected text and show evidence in a side panel.",
  "permissions": ["contextMenus", "storage", "sidePanel", "activeTab"],
  "host_permissions": ["https://infoverify.dpdns.org/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "options_page": "src/options/options.html"
}
